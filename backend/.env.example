# Server
NODE_ENV=development
PORT=5800

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=1d

# CORS
# Use comma-separated origins in production, e.g. https://app.example.com,https://www.app.example.com
# Use * only for local dev/testing without credentials
CORS_ORIGIN=http://localhost:3000

# OTP/Auth policy (optional)
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=10

# Email (OTP)
BREVO_API_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=MockMate Pro
# Backward-compatible sender format (optional)
EMAIL_FROM=MockMate Pro <no-reply@yourdomain.com>

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# OpenRouter
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=MockMate Pro
OPENROUTER_BATCH_SIZE=5
OPENROUTER_MAX_COMPLETION_TOKENS=1800
