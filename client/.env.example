# Frontend API Configuration
# Development: http://localhost:5800/api
# Production (Render): https://your-render-backend-url.onrender.com/api
# Example production: VITE_API_BASE_URL=https://mockmate-api.onrender.com/api
VITE_API_BASE_URL=https://your-render-backend-url.onrender.com/api

# Razorpay public key (safe for frontend)
# Use test keys for staging, live keys for production
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

